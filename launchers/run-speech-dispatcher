#!/bin/sh
# App "speech-dispatcher" launcher.
#
# Runs as a snapd socket-activated user daemon: the generated socket
# unit passes the listening fd (speechd supports systemd socket
# activation via sd_listen_fds), and the command line mirrors the
# deb's own user service ExecStart (/usr/bin/speech-dispatcher -s -t 0:
# single-process mode, no speechd-internal timeout shutdown).

case "$(uname -m)" in
    x86_64)  TRIPLET=x86_64-linux-gnu ;;
    aarch64) TRIPLET=aarch64-linux-gnu ;;
    *)       TRIPLET="" ;;
esac

# Audio: the audio-playback plug (connected to the pipewire snap)
# grants this process /run/user/<uid>/snap.pipewire/pulse/native
# (interfaces/builtin/audio_playback.go:182 forms that path from the
# slot snap's instance name on Core). $XDG_RUNTIME_DIR inside the snap
# is the snap-PRIVATE runtime dir, so recover the real per-UID dir by
# stripping the snap.<name> suffix - this is the fat line's
# PULSE_SERVER fix, with the absolute Core socket path.
#
# Why the slot-snap instance name is hard-coded: the connected-plug
# AppArmor grant is parameterized with the SLOT snap's instance name at
# profile generation, but snapd exposes no env/metadata for it to the
# plug side (SNAP_* variables are all self-referential), and nothing
# else identifies the pulse server socket. libpulse's own discovery
# ($XDG_RUNTIME_DIR/pulse/native) is exactly the path confinement
# breaks. If the slot snap is ever renamed/sideloaded under a different
# instance name, this path breaks loudly (connection refused -> speechd
# audio init fails). SEE README "Spike questions" #6: needs a snapd
# mechanism (e.g. an interface-provided env var) to be robust.
real_rt="${XDG_RUNTIME_DIR%/snap.*}"
export PULSE_SERVER="unix:${real_rt}/snap.pipewire/pulse/native"

# libespeak-ng honours ESPEAK_DATA_PATH (<parent>/espeak-ng-data);
# the layout bind mirrors the data to the compiled-in absolute path as
# a second safety net.
if [ -n "$TRIPLET" ]; then
    export ESPEAK_DATA_PATH="$SNAP/usr/lib/$TRIPLET"
    # T20 E3 follow-up: libpulsecommon-17.0.so (needed by the espeak
    # module and the pulse audio plugin) is staged in the pulseaudio/
    # subdir, which no loader path covered; the layout bind fixes the
    # RPATH route, this covers any env-only resolution.
    export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}$SNAP/usr/lib/$TRIPLET/pulseaudio"
fi

# T50: snap-scoped sem_open shim (the E3 fix that lets sd_dummy ship).
# The dummy module's sem_open uses an unscoped /dev/shm/sem.* name the
# strict template can never grant (T20 E3: SEM_FAILED -> unchecked ->
# the module's speak thread SIGSEGVs), which is why sd_dummy was
# stage-filtered out. The shim (launchers/sem-snap-shim.c, compiled in
# the launchers part) rewrites unscoped sem names into the granted
# sem.snap.ubuntu-desktop-a11y.* namespace - ZERO new AppArmor surface.
# Exported here so the SERVER and every output-module child inherit it;
# it only rewrites sem_open/sem_unlink names (sem_wait/post work on the
# returned pointer and are unaffected), so the working espeak path is
# untouched. See the E3 comment in snap/snapcraft.yaml for the whole
# story and the T50 deliverable for the live verification.
export LD_PRELOAD="${LD_PRELOAD:+$LD_PRELOAD:}$SNAP/lib/sem-snap-shim.so"

# T47: the unit's main process is now the hung-server WATCHDOG (the
# supervisor, bin/speechd-supervisor.py), not the server itself. The
# supervisor receives the socket-activation fd (LISTEN_FDS), spawns
# the real server as its CHILD with LISTEN_PID rewritten, probes the
# socket every 15 s with a connect + greeting read (10 s kill
# threshold; 30 s startup grace), and SIGKILLs + respawns the server
# when the greeting stops coming - the T41/T44-era wedge (server
# alive, unresponsive, SIGTERM swallowed, restart-condition:
# on-failure blind to it) now self-heals, riding the recovery T44
# proved: a killed server is respawned against the same listening
# fd and serves the next client (rc=0). The listening fd never
# leaves this process, so connections queued during a wedge are
# still served by the fresh server - no fight with the
# socket-activation unit. Full rationale + the strict-template grant
# audit (same-snap signal, snap-runtime-dir connect) in
# notes/todo/a11y-work/T47-watchdog-lint.txt.
exec "$SNAP/usr/bin/python3" "$SNAP/bin/speechd-supervisor.py"
