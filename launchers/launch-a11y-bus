#!/bin/sh
# App "bus" launcher (T11 design review section 3).
#
# snapd's dbus activation Exec's this unit when any client calls
# org.a11y.Bus.GetAddress on the session bus; the wrapper stays in the
# foreground (daemon: dbus) and delegates everything to
# at-spi-bus-launcher, which:
#   - registers org.a11y.Bus on the session bus it inherits via
#     DBUS_SESSION_BUS_ADDRESS,
#   - spawns its own PRIVATE accessibility dbus-daemon
#     (compiled-in fallback /usr/bin/dbus-daemon -> the core26 base's
#     binary, exec-allowed ixr by the strict template; config file
#     /usr/share/defaults/at-spi2/accessibility.conf reached via the
#     snap layout, keeping <type>accessibility</type> mediation),
#   - places the private bus under $XDG_RUNTIME_DIR/at-spi (in a strict
#     snap: /run/user/<uid>/snap.ubuntu-desktop-a11y/at-spi), and
#   - lets the private bus activate /usr/libexec/at-spi2-registryd
#     (layout symlink) from the staged accessibility-services dir
#     (layout bind).
# Nothing is hand-orchestrated here on purpose; the launcher's own
# config decides where its private bus lives.

# User daemons normally inherit DBUS_SESSION_BUS_ADDRESS from the
# systemd user manager. Keep a defensive fallback for bare contexts
# so GetAddress activation still has a bus to register on.
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    # strip the snap-private /snap.<name> suffix to recover the real
    # per-UID runtime dir; if the suffix is absent (unconfined run)
    # XDG_RUNTIME_DIR is already the real one.
    real_rt="${XDG_RUNTIME_DIR%/snap.*}"
    export DBUS_SESSION_BUS_ADDRESS="unix:path=${real_rt}/bus"
fi

# T19 D2 (T11 §3): bind the private bus on the CONVENTIONAL per-uid
# at-spi path instead of the snap-private runtime dir. snap-run rewrites
# XDG_RUNTIME_DIR to /run/user/<uid>/snap.<instance>; strip that suffix
# (a no-op when the suffix is absent). Client-side access to the socket
# comes from desktop-legacy's stock conventional-path rule, so no
# snap.* path wildcard is needed anywhere (T17 D2: a snap.* wildcard
# would admit every snap's at-spi socket for X11-property
# redirection). The daemon-side grants for this path live in the
# accessibility-provider slot's snippet.
real_rt="${XDG_RUNTIME_DIR%/snap.*}"
export XDG_RUNTIME_DIR="$real_rt"

# gsettings-desktop-schemas is staged (the launcher reads GSettings at
# startup); glib resolves the default schema source from
# $XDG_DATA_DIRS/glib-2.0/schemas. T13 runtime finding: without this
# the launcher aborts with "Cannot get the default
# GSettingsSchemaSource - is the gsettings-desktop-schemas package
# installed?" before owning org.a11y.Bus (the global snapcraft
# environment only carries LD_LIBRARY_PATH/PATH).
# Deliberately NOT appending the inherited value: the greeter session
# env carries content-snap data dirs (/snap/gnome-desktop-runtime/...)
# which a confined launcher is denied to read (AppArmor noise AVCs);
# $SNAP/usr/share holds everything the launcher needs.
export XDG_DATA_DIRS="$SNAP/usr/share"

exec "$SNAP/usr/libexec/at-spi-bus-launcher" --launch-immediately
