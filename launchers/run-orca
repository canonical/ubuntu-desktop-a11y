#!/bin/sh
# App "orca" launcher.
#
# The deb's /usr/bin/orca has shebang #!/usr/bin/python3, which inside
# the snap's mount namespace would resolve against the BASE (core26
# ships no python). T4's host-side shebang rewrite therefore becomes a
# wrapper fix here: exec the staged interpreter directly.
# Env plumbing mirrors pipewire-snap's env pattern.

# gi overrides (Atspi.py etc.) and orca's modules live in the staged
# Debian dist-packages tree.
export PYTHONPATH="$SNAP/usr/lib/python3/dist-packages${PYTHONPATH:+:$PYTHONPATH}"

# Multiarch triplet detection, mirroring run-speech-dispatcher. The snap
# is single-platform per build (build-for == runtime arch), so uname -m
# is authoritative at runtime.
case "$(uname -m)" in
    x86_64)  TRIPLET=x86_64-linux-gnu ;;
    aarch64) TRIPLET=aarch64-linux-gnu ;;
    *)       TRIPLET="" ;;
esac

# glib schemas (org.gnome.Orca + org.gnome.desktop.a11y.*) are compiled
# into $SNAP/usr/share/glib-2.0/schemas by the a11y-stack part; glib
# looks in $XDG_DATA_DIRS/glib-2.0/schemas.
export XDG_DATA_DIRS="$SNAP/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"

# T14 finding #3: the greeter session env carries GI_TYPELIB_PATH (and
# GSETTINGS_SCHEMA_DIR) pointing at the gnome-desktop-runtime content
# snap; inside the orca label those reads are DENIED (content-interface
# grants only the content provider's snaps) and typelib discovery fails
# ("Namespace Atspi not available"). Same precedent as 63ed7fb/4937cb0:
# pin the pointer at the snap's own tree instead of inheriting the
# session's. The snap stages gir1.2-atspi-2.0 et al into
# $SNAP/usr/lib/<triplet>/girepository-1.0; the session env is dropped
# entirely so the denied content-snap paths are never searched.
if [ -n "$TRIPLET" ]; then
    export GI_TYPELIB_PATH="$SNAP/usr/lib/$TRIPLET/girepository-1.0"
else
    # Unknown triplet: still drop the session's pointer (denied paths),
    # even though typelib discovery will fail without a staged tree.
    unset GI_TYPELIB_PATH
fi

# T28 (NEW-4): the GREETER's user manager env carries gdm's seat-scoped
# XDG_CONFIG_HOME (/var/lib/gdm3/seat0/config) and GSETTINGS_SCHEMA_DIR
# (content-snap path). Inside the snap mount namespace /var/lib/gdm3
# does not exist at all (gdm's fstab bind is not replicated into snap
# namespaces), so glib's keyfile settings backend fails at init with
# "Failed to create /var/lib/gdm3/seat0/config/glib-2.0/settings:
# Read-only file system" on every reader start (non-fatal on clean
# bits — the T27 SEGV downstream of it was the overlay artifact — but
# it fires for every confined greeter daemon and never persists).
# GSETTINGS_SCHEMA_DIR is denied under this label (the T14 class).
# Point the config home at the snap's own per-user data dir (guaranteed
# writable, ephemeral with the greeter home) and drop the denied
# schema pointer; the snap's own schemas resolve via XDG_DATA_DIRS.
# GDK_PIXBUF_MODULE_FILE is the same class: the greeter env points it
# at the content snap's loaders.cache, denied under this label (one
# open denial per reader start).
export XDG_CONFIG_HOME="${SNAP_USER_DATA}/.config"

# T30 item 6 (T29 C7): suppress orca's periodic inet socket attempts
# WITHOUT granting network. orca's braille support retries a BrlAPI
# (brltty) connection forever; with the default connection settings the
# retry resolves "localhost" and attempts one inet plus one inet6 TCP
# connect per cycle (~2 denials/minute under this profile, ~232/boot).
# This snap ships no brltty daemon and braille hardware is a separate
# privilege domain (T11 §2), so point BrlAPI at a snap-owned UNIX
# socket path instead: the connect fails with ENOENT inside a directory
# this profile already owns, no host resolution happens and no
# network-shaped socket is ever attempted. (The compiled
# org.gnome.Orca.Braille enabled=false default does not bite because
# orca's braille state initialises to True and only syncs the setting
# on change - braille.py _STATE dataclass default.)
export BRLAPI_HOST="${SNAP_USER_DATA}/.config/brlapi.sock"
mkdir -p "$XDG_CONFIG_HOME" 2>/dev/null
unset GSETTINGS_SCHEMA_DIR
unset GDK_PIXBUF_MODULE_FILE

# speech-dispatcher runs as a snapd socket-activated user daemon of the
# SAME snap: its socket lands in this snap's private runtime dir, which
# is exactly what $XDG_RUNTIME_DIR points at inside the snap. T13
# runtime finding: speechd.client._connection_arguments_from_address
# (the staged 0.12.1) only accepts the method string "unix_socket" with
# the path as the SECOND ':'-field — "unix:path:..." raises "Unknown
# communication method in address".
export SPEECHD_ADDRESS="unix_socket:${XDG_RUNTIME_DIR}/speech-dispatcher/speechd.sock"

# T52: the wizard session's confined compositor creates its wayland
# socket under the SESSION snap's private runtime dir
# (/run/user/<uid>/snap.ubuntu-desktop-session/wayland-N). The manager
# env orca.service inherits does not reliably carry a usable
# WAYLAND_DISPLAY there: the session-snap environment-broker rewrites
# the bare name to the absolute socket path for what flows through it,
# but the shell's own direct SetEnvironment export lands as the bare
# name and the manager env can drop the value entirely — orca then
# falls back to X11, whose auth file lives in the session snap's
# private dir this profile cannot read ("Authorization required, but no
# authorization protocol specified" -> display None -> the T16 keymap
# death, observed live on the T52 wizard). Resolve the session socket
# directly instead: the wayland plug is connected to
# ubuntu-desktop-session:wayland, and the wayland interface's slot-side
# grant covers exactly the snap.ubuntu-desktop-session socket path, and
# the profile grants the socket FILE (wayland-[0-9]* rw) but NOT the
# directory listing, so probe the exact conventional socket name instead
# of globbing. Same absolutization shape as the session snap's run.sh.
_w="/run/user/$(id -u)/snap.ubuntu-desktop-session/wayland-0"
if [ -z "${WAYLAND_DISPLAY:-}" ] || [ "${WAYLAND_DISPLAY#/}" = "${WAYLAND_DISPLAY}" ]; then
	[ -S "$_w" ] && export WAYLAND_DISPLAY="$_w"
fi
unset _w

# T23 (first user-session run on thin): orca spawns xkbcomp while
# setting up its keyboard grab, and the user-session manager env (the
# confined session snap's environment broker output) carries no PATH
# entry that resolves it — FileNotFoundError: 'xkbcomp'. The greeter
# worked by accident: gdm's content-runtime session env has a PATH that
# reaches the host's xkbcomp. The snap stages x11-xkb-utils (see
# snapcraft.yaml); point PATH at the snap's own bin dir so the spawn
# resolves identically in every session placement.
export PATH="$SNAP/usr/bin:$SNAP/bin${PATH:+:$PATH}"

exec "$SNAP/usr/bin/python3" "$SNAP/usr/bin/orca" --replace "$@"
